# Local development only: copy to .env. In Docker, these come from
# docker-compose.yml. Local state lives in .dev/ (gitignored); the Cove token
# stays outside the repository.
APP_ENV=dev
COVE_URL=http://localhost:2110
COVE_TOKEN_PATH=../lighthouse-dev/cove-token
APP_REPO_PATH=.dev/repos.json
STAGING_PATH=.dev/staging/
DOWNLOAD_PATH=.dev/download/
LIGHTHOUSE_CONTROL_SOCKET=.dev/control.sock
# LIGHTHOUSE_POLL_INTERVAL=10s
