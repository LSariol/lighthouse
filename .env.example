# Local development only: copy to .env. In Docker, these come from
# docker-compose.yml. Everything a local run reads or writes stays in .dev/
# (gitignored and kept out of Docker builds), including the dev Cove token.
# Nothing is written outside the repository.
APP_ENV=dev
COVE_URL=http://localhost:2110
COVE_TOKEN_PATH=.dev/cove-token
STAGING_PATH=.dev/staging/
# The projects' data folders (/srv/server/storage on the server).
STORAGE_PATH=.dev/storage/
LIGHTHOUSE_CONTROL_SOCKET=.dev/control.sock
# LIGHTHOUSE_POLL_INTERVAL=10s
