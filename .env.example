# Local development only: copy to .env. In Docker, these come from
# docker-compose.yml. Keep secrets (the Cove token) outside the repository.
APP_ENV=dev
COVE_URL=http://localhost:2110
COVE_TOKEN_PATH=../lighthouse-dev/cove-token
APP_REPO_PATH=config/repos.json
STAGING_PATH=Server/Staging/
DOWNLOAD_PATH=Server/Download/
LIGHTHOUSE_CONTROL_SOCKET=Server/control.sock
# LIGHTHOUSE_POLL_INTERVAL=10s
