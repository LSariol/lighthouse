# Local development only: copy to .env. Everything a local run touches stays in .dev/.
APP_ENV=dev
COVE_URL=http://localhost:2110
COVE_TOKEN_PATH=.dev/cove-token
STAGING_PATH=.dev/staging/
STORAGE_PATH=.dev/storage/
BACKUP_PATH=.dev/backups/
LIGHTHOUSE_CONTROL_SOCKET=.dev/control.sock
# LIGHTHOUSE_POLL_INTERVAL=10s
